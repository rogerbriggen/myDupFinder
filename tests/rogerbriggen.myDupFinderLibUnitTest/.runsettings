<?xml version="1.0" encoding="utf-8"?>
<!-- Used by every "dotnet test" of this project (see RunSettingsFilePath in the csproj), so also by CI and by other people. -->
<RunSettings>
  <RunConfiguration>
    <!-- Hard limit for the whole test session in milliseconds (10 minutes). The run is aborted when it takes longer; a normal run takes well under a minute. -->
    <TestSessionTimeout>600000</TestSessionTimeout>
  </RunConfiguration>
</RunSettings>
